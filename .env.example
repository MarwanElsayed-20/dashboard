# Copy to .env.local for local work. Without DATABASE_URL, `pnpm dev` uses sample messages in memory.

# Neon Postgres (Vercel → Storage → Neon). `pnpm db:migrate` creates the tables.
DATABASE_URL=

# Login. `pnpm setup:password` prints OWNER_PASSWORD_HASH; `pnpm setup:secrets` prints the rest.
OWNER_PASSWORD_HASH=
SESSION_SECRET=

# The portfolio's contact route sends messages with this key (DASHBOARD_INGEST_SECRET there).
INGEST_SECRET=

# Web push (VAPID). The subject is a contact address for push services.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
